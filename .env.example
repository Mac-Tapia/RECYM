# RECYM workstation — no versionar. Copiar desde .env.example
RECYM_ENV=development
RECYM_AUTH=1
RECYM_UI_HOST=127.0.0.1
RECYM_UI_PORT=5055
RECYM_ISOLATE_JOBS=1
# RECYM_API_KEY=  (si vacío se genera en config/.api_key)
# RECYM_CORS_ORIGINS=http://127.0.0.1:5055,http://localhost:5055
# RECYM_ALLOW_LAN=0
# GOOGLE_MAPS_API_KEY=
