{
  "version": "0.2.0",
  "configurations": [
    

    {
      "name": "RECYM: check environment",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/core/check_environment.py",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.tools/python37-win32/python.exe",
      "console": "integratedTerminal"
    },
    {
      "name": "RECYM: pipeline CA101",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/pipeline/run_all.py",
      "args": ["--feeder", "CA101"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.tools/python37-win32/python.exe",
      "console": "integratedTerminal"
    },
    {
      "name": "RECYM: max demand multi CA101V2",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/pipeline/apply_max_demand_multi.py",
      "args": ["--feeder", "CA101"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.tools/python37-win32/python.exe",
      "console": "integratedTerminal"
    },
    {
      "name": "RECYM: demand UI",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/ui/demand_app.py",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.tools/python37-win32/python.exe",
      "console": "integratedTerminal"
    },
    {
      "name": "RECYM: test CYMDIST connection",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/src/core/test_cymdist_connection.py",
      "args": ["--feeder", "CA101"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.tools/python37-win32/python.exe",
      "console": "integratedTerminal"
    }
  ]
}
